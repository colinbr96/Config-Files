// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "dock": "right",
    "favorite_models": []
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "Inconsolata",
  "buffer_font_size": 14.5,
  "buffer_font_weight": 500,
  "buffer_line_height": "standard",
  "collaboration_panel": {
    "dock": "left"
  },
  "confirm_quit": true,
  "disable_ai": true,
  "file_types": {
    "jinja": ["*.jinja"],
    "perl": ["Config"]
  },
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": {
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Latte",
    "mode": "dark"
  },
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "tabs": {
    "file_icons": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "font_family": "Inconsolata",
    "font_size": 14.5,
    "font_weight": 500,
    "shell": {
      "program": "C:\\Program Files\\Git\\bin\\bash.exe"
    }
  },
  "theme": {
    "dark": "Catppuccin Macchiato",
    "light": "One Light",
    "mode": "dark"
  },
  "theme_overrides": {
    "Catppuccin Macchiato": {
      "terminal.background": "#1e2030"
    },
    "One Light": {
      "terminal.background": "#ebebec"
    }
  },
  "title_bar": {
    "show_sign_in": false
  },
  "ui_font_family": "Segoe UI",
  "ui_font_size": 17.0,
  "wrap_guides": [120]
}
